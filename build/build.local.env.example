# Copiar a build/build.local.env (ignorado por git) y completar.
# Estas variables pisan las de build.env cuando el script las carga.
#
# IMPORTANTE: si TARGET_PASSWORD / ROOT_PASSWORD quedan vacíos, 30-configure.sh
# genera passwords aleatorias y las guarda SOLO en /root/build-credentials.txt
# dentro de la imagen. Anotarlas o definirlas acá para no quedar afuera del
# sistema en el primer login (nos pasó en la prueba de F7).
TARGET_PASSWORD=cambiame-antes-de-construir
ROOT_PASSWORD=cambiame-tambien
