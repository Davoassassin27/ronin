# =============================================================================
# Ronin - parametros de construccion
# =============================================================================
# Este archivo se versiona. NO poner secretos aca: usar build/build.local.env
# (ignorado por git) o variables de entorno.
#
# Formato simple KEY=VALUE, sin espacios alrededor del "=".
# =============================================================================

# --- Host / QEMU -------------------------------------------------------------
VM_NAME=ronin-build
IMAGE_DIR=E:/work-os/images
IMAGE_NAME=ronin.img
IMAGE_SIZE=120G
ISO_DIR=build/iso
ISO_NAME=cachyos-desktop-linux-260809.iso
ISO_SHA256=959f6577f45e25ee9fd8c220fd221b08e4ea79412c7315c0f922dd6d86d5e33c
ISO_URL=https://mirror.cachyos.org/ISO/desktop/260809/cachyos-desktop-linux-260809.iso
ISO_SHA256_URL=https://mirror.cachyos.org/ISO/desktop/260809/cachyos-desktop-linux-260809.iso.sha256

VM_CPUS=8
VM_MEMORY_MB=12288
# WHPX congeló el guest tras el reboot con kernel 7.3.3 (QEMU 11.1.0).
# TCG es más lento pero estable en este host. Cambiar a "whpx" si se valida.
VM_ACCEL=tcg
VM_DISPLAY=gtk
SSH_PORT=2222
SSH_KEY=%USERPROFILE%/.ssh/ronin_ed25519
SSH_KNOWN_HOSTS=NUL

# --- Imagen objetivo ---------------------------------------------------------
# La imagen se construye con 2 particiones (ESP 1 GiB + Btrfs resto).
# La migracion al NVMe crea la tabla final de 3 particiones.
TARGET_DISK=/dev/vda
ESP_SIZE=1G
ROOT_LABEL=CACHY_ROOT

# --- Sistema instalado -------------------------------------------------------
TARGET_HOSTNAME=ronin
TARGET_USER=davosoler
TARGET_TIMEZONE=America/Argentina/Buenos_Aires
TARGET_LOCALE=es_AR.UTF-8
TARGET_KEYMAP=la-latin1
TARGET_SHELL=/bin/bash
TARGET_GROUPS=wheel,video,audio,input,storage,optical

# Password del usuario/root. Dejar vacio para generar uno aleatorio y guardarlo
# en /root/build-credentials.txt dentro de la imagen (modo 600).
# Preferir build/build.local.env para no versionar secretos.
TARGET_PASSWORD=
ROOT_PASSWORD=

# --- Stack / features --------------------------------------------------------
INSTALL_OMARCHY=yes
OMARCHY_MODE=overlay
OMARCHY_REPO=https://github.com/omacom/omarchy.git
OMARCHY_REF=quattro
OMARCHY_AUTOLOGIN=yes
# NVIDIA open DKMS bajo TCG tarda >20 min y no es verificable en QEMU.
# Instalar en el hardware real con: pacman -S nvidia-open-dkms nvidia-utils
INSTALL_NVIDIA=no
INSTALL_GAMING=yes
ENABLE_FIREWALL=yes

# --- Migracion a NVMe --------------------------------------------------------
# Estos valores aplican al disco fisico final de 1 TB (931.5 GiB utiles).
# DATOS ~500 GiB, ESP 4 GiB (margen para Limine/snapshots de Omarchy),
# ROOT resto (~427 GiB). El root de la imagen (120 GiB) se copia al inicio y
# luego se expande con `btrfs filesystem resize max`.
NVME_DATA_SIZE=500G
NVME_ESP_SIZE=4G
NVME_TARGET=/dev/nvme0n1
